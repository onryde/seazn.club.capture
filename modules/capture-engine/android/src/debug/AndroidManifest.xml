<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Task 34: debug builds only. Fills HttpSeam with the scripted code server before the engine is built. -->
    <provider
      android:name="com.seazn.capture.engine.debug.ScriptedServerInstaller"
      android:authorities="${applicationId}.scripted-code"
      android:exported="false" />
    <!-- N42's device check: debug builds only. Fills PreviewSeam with a broadcast that lays the preview's SurfaceView out at 0 x 0. -->
    <provider
      android:name="com.seazn.capture.engine.debug.LoseSurfaceInstaller"
      android:authorities="${applicationId}.lose-surface"
      android:exported="false" />
  </application>
</manifest>
